# Normalize line endings so the repository is stable across Windows, macOS
# and CI (Linux). Source files are stored as LF, checked out as-is.
* text=auto eol=lf

*.md text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.zip binary

# Keep GitHub's language stats honest.
docs/assets/* linguist-documentation
